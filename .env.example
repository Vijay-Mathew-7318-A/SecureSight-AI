# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file to GitHub.

# Claude API key (optional). Leave empty to use rule-based fallback explanations.
ANTHROPIC_API_KEY=

# Claude model name (check Anthropic's docs for the current model name)
ANTHROPIC_MODEL=

# SQLite database location
DATABASE_URL=sqlite:///./securesight.db

# Request timeout (seconds) for scanning
REQUEST_TIMEOUT=10